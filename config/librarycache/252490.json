[["achievements",{"version":2,"data":{"vecHighlight":[{"strID":"KILL_SCIENTIST","strName":"Something of a scientist myself","strDescription":"Kill 5 Scientists","bAchieved":true,"rtUnlocked":1710164532,"strImage":"https://shared.steamstatic.com/community_assets/images/apps/252490/2d9ec986506f0c9361f89aa2f877ae0ef19b88a2.jpg","bHidden":true,"flMinProgress":0,"flCurrentProgress":6,"flMaxProgress":5,"flAchieved":33.5},{"strID":"CRAFT_BURLAP_SHIRT","strName":"Craft Burlap Shirt","strDescription":"Craft a Burlap Shirt","bAchieved":true,"rtUnlocked":1709878998,"strImage":"https://shared.steamstatic.com/community_assets/images/apps/252490/d3ab09d3756e27167e8fafc4636cfa045a7710f0.jpg","bHidden":false,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0,"flAchieved":21.899999618530273},{"strID":"PLACE_WORKBENCH","strName":"Place a Workbench","strDescription":"Place a Workbench","bAchieved":true,"rtUnlocked":1704904920,"strImage":"https://shared.steamstatic.com/community_assets/images/apps/252490/bcaec1a3ca191273ad366ffdff4f30d74e29fd3f.jpg","bHidden":false,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0,"flAchieved":18.700000762939453},{"strID":"PLACE_RESEARCH_TABLE","strName":"Place a Research Table","strDescription":"Place a Research Table","bAchieved":true,"rtUnlocked":1704487211,"strImage":"https://shared.steamstatic.com/community_assets/images/apps/252490/8e4e3005464436ee3077a7852373f6afc7cc5c22.jpg","bHidden":false,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0,"flAchieved":15.600000381469727},{"strID":"CRAFT_BURLAP_PANTS","strName":"Craft Burlap Pants","strDescription":"Craft Burlap Pants","bAchieved":true,"rtUnlocked":1704448174,"strImage":"https://shared.steamstatic.com/community_assets/images/apps/252490/18245f5b1a0bbc1a01f3260e3b05714e926c33eb.jpg","bHidden":false,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0,"flAchieved":22.200000762939453},{"strID":"SAVE_THE_PLANET","strName":"Save The Planet","strDescription":"Recycle 5 emp